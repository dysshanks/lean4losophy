#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The Aporia Authors
"""Generate app and paper design outputs from design/tokens.toml.

Outputs (all committed, so a checkout needs no Python to build):

  design/theme.css        light GTK4/libadwaita colours, type, radius, shadow
  design/theme-dark.css   dark GTK4/libadwaita colours and shadow
  design/paper-tokens.typ Typst variables for the paper templates
  design/tokens.json      resolved tokens for tests and documentation

Also checks every configured WCAG contrast pair and exits nonzero on a failure.

Usage:
  python3 scripts/gen-design-tokens            # write the outputs
  python3 scripts/gen-design-tokens --check    # fail if outputs are stale
"""

from __future__ import annotations

import colorsys
import json
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOKENS = ROOT / "design" / "tokens.toml"


def hsl_hex(colour: dict[str, float]) -> str:
    r, g, b = colorsys.hls_to_rgb(
        colour["h"] / 360.0, colour["l"], colour["s"]
    )
    return "#{:02x}{:02x}{:02x}".format(
        round(r * 255), round(g * 255), round(b * 255)
    )


def luminance(hex_colour: str) -> float:
    channels = []
    for offset in (1, 3, 5):
        value = int(hex_colour[offset : offset + 2], 16) / 255.0
        channels.append(
            value / 12.92
            if value <= 0.04045
            else ((value + 0.055) / 1.055) ** 2.4
        )
    r, g, b = channels
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(a: str, b: str) -> float:
    la, lb = luminance(a), luminance(b)
    lighter, darker = max(la, lb), min(la, lb)
    return (lighter + 0.05) / (darker + 0.05)


def check_contrast(data: dict) -> list[str]:
    failures = []
    for pair in data.get("contrast", []):
        theme = pair["theme"]
        palette = data["color"][theme]
        fg = hsl_hex(palette[pair["fg"]])
        bg = hsl_hex(palette[pair["bg"]])
        ratio = contrast_ratio(fg, bg)
        if ratio < pair["min"]:
            failures.append(
                f"{theme}: {pair['fg']} on {pair['bg']} is {ratio:.2f}:1, "
                f"needs {pair['min']}:1 (fg {fg}, bg {bg})"
            )
    return failures


def colour_block(data: dict, theme: str) -> str:
    lines = []
    for name, value in data["color"][theme].items():
        lines.append(f"@define-color aporia_{name} {hsl_hex(value)};")
    return "\n".join(lines)


RGBA = re.compile(r"rgba\(0,0,0,([0-9.]+)\)")


def shadow_block(data: dict, theme: str) -> str:
    scale = 1.0 if theme == "light" else data["elevation"]["dark_scale"]
    lines = []
    for name in ("level1", "level2", "level3"):
        value = data["elevation"][name]
        if scale != 1.0:
            value = RGBA.sub(
                lambda match: f"rgba(0,0,0,{float(match.group(1)) * scale:.3f})",
                value,
            )
        lines.append(f".aporia-shadow-{name} {{ box-shadow: {value}; }}")
    return "\n".join(lines)


def type_block(data: dict) -> str:
    typo = data["typography"]
    rows = [
        ("caption", typo["caption_size"], typo["caption_line"], typo["body_weight"]),
        ("body", typo["body_size"], typo["body_line"], typo["body_weight"]),
        (
            "body-large",
            typo["body_large_size"],
            typo["body_large_line"],
            typo["body_weight"],
        ),
        ("h3", typo["h3_size"], typo["h3_line"], typo["heading_weight"]),
        ("h2", typo["h2_size"], typo["h2_line"], typo["heading_weight"]),
        ("h1", typo["h1_size"], typo["h1_line"], typo["heading_weight"]),
        (
            "display",
            typo["display_size"],
            typo["display_line"],
            typo["heading_weight"],
        ),
    ]
    return "\n".join(
        f".aporia-{name} {{ font-size: {size}px; line-height: {line}px; "
        f"font-weight: {weight}; }}"
        for name, size, line, weight in rows
    )


def radius_block(data: dict) -> str:
    radius = data["radius"]
    return "\n".join(
        f".aporia-radius-{name} {{ border-radius: {value}px; }}"
        for name, value in radius.items()
    )


def gtk_css(data: dict, theme: str) -> str:
    header = (
        "/* Generated by scripts/gen-design-tokens from design/tokens.toml. */\n"
        "/* Do not edit by hand. Edit the token file and rerun the generator. */\n"
        f"/* Theme: {theme}. Load with Gtk.StyleContext.add_provider_for_display. */\n\n"
    )
    body = [
        colour_block(data, theme),
        "",
        type_block(data),
        "",
        radius_block(data),
        "",
        shadow_block(data, theme),
        "",
    ]
    return header + "\n".join(body)


def typst_tokens(data: dict) -> str:
    light = {name: hsl_hex(value) for name, value in data["color"]["light"].items()}
    dark = {name: hsl_hex(value) for name, value in data["color"]["dark"].items()}
    paper = data["paper"]
    typo = data["typography"]
    lines = [
        "// Generated by scripts/gen-design-tokens from design/tokens.toml.",
        "// Do not edit by hand. Edit the token file and rerun the generator.",
        "",
        "#let aporia = (",
        f'  body-font: "{paper["body_font"]}",',
        f'  heading-font: "{paper["heading_font"]}",',
        f"  body-size: {paper['body_size_pt']}pt,",
        f"  body-leading: {paper['body_leading']},",
        f"  heading-leading: {paper['heading_leading']},",
        f"  measure-chars: {paper['measure_chars']},",
        f'  page-size: "{paper["page_size"]}",',
        f"  margin-top: {paper['margin_top_mm']}mm,",
        f"  margin-bottom: {paper['margin_bottom_mm']}mm,",
        f"  margin-left: {paper['margin_left_mm']}mm,",
        f"  margin-right: {paper['margin_right_mm']}mm,",
        f"  heading-space-above: {paper['heading_space_above_pt']}pt,",
        f"  heading-space-below: {paper['heading_space_below_pt']}pt,",
        f"  heading-weight: {typo['heading_weight']},",
        f"  caption-leading: {paper['caption_leading']},",
        "  light: (",
    ]
    for name, value in light.items():
        lines.append(f'    {name}: rgb("{value}"),')
    lines.append("  ),")
    lines.append("  dark: (")
    for name, value in dark.items():
        lines.append(f'    {name}: rgb("{value}"),')
    lines.append("  ),")
    lines.append(")")
    lines.append("")
    return "\n".join(lines)


def resolved_json(data: dict) -> str:
    resolved = {
        "meta": data["meta"],
        "color": {
            theme: {name: hsl_hex(value) for name, value in palette.items()}
            for theme, palette in data["color"].items()
        },
        "typography": data["typography"],
        "spacing": data["spacing"],
        "radius": data["radius"],
        "elevation": data["elevation"],
        "paper": data["paper"],
    }
    return json.dumps(resolved, indent=2, sort_keys=True) + "\n"


def main(argv: list[str]) -> int:
    check_only = "--check" in argv[1:]
    raw = TOKENS.read_bytes()
    try:
        data = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        print(f"error: cannot read {TOKENS}: {error}", file=sys.stderr)
        return 1

    failures = check_contrast(data)
    if failures:
        for failure in failures:
            print(f"error: contrast: {failure}", file=sys.stderr)
        return 1

    outputs = {
        ROOT / "design" / "theme.css": gtk_css(data, "light"),
        ROOT / "design" / "theme-dark.css": gtk_css(data, "dark"),
        ROOT / "design" / "paper-tokens.typ": typst_tokens(data),
        ROOT / "design" / "tokens.json": resolved_json(data),
    }

    stale = []
    for path, content in outputs.items():
        if path.exists() and path.read_text(encoding="utf-8") == content:
            continue
        if check_only:
            stale.append(path.relative_to(ROOT))
            continue
        path.write_text(content, encoding="utf-8")
        print(f"wrote {path.relative_to(ROOT)}")

    if stale:
        for path in stale:
            print(
                f"error: {path} is stale; run python3 scripts/gen-design-tokens",
                file=sys.stderr,
            )
        return 1

    if check_only:
        print("info: design tokens are up to date")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
